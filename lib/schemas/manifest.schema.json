{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moca/schemas/v1/manifest.schema.json",
  "title": "MOCA package manifest (moca.json)",
  "description": "Normative schema for moca.json. See spec/moca-package-spec.md section 4.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "mocaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?![\\s\\S])",
      "description": "The MOCA specification version the package was written against, major.minor."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
      "description": "Absolute URI naming the package across all its versions. https: or tag: URIs are recommended. It never contains #: a node identifier is the id, #, and the node path.",
      "not": {
        "pattern": "#"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])",
      "description": "Content version, following the content-versioning rules in spec section 4.3."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "datePublished": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ],
      "description": "When the package was first published: the W3C Publication Manifest's datePublished (spec/moca-package-spec.md §4.12). Informative."
    },
    "datePackaged": {
      "type": "string",
      "format": "date-time",
      "description": "When this version of the package was made: an RFC 3339 date-time with an offset (spec/moca-package-spec.md §4.12). Informative."
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])",
      "description": "BCP 47 tag of the default-language content."
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
      },
      "uniqueItems": true,
      "description": "BCP 47 tags of additional locale variants, see spec section 5.4."
    },
    "license": {
      "type": "string",
      "description": "SPDX license expression."
    },
    "publisher": {
      "$ref": "#/$defs/publisher"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+(?![\\s\\S])",
      "maxLength": 2048,
      "description": "The work's own web page (spec section 4.13). Never fetched by a Reader."
    },
    "contributors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/contributor"
      },
      "description": "People and organisations credited for the whole package, with MARC relator roles (spec section 4.13)."
    },
    "distribution": {
      "enum": ["open", "encrypted-only", "service-only"],
      "description": "How the publisher intends the package to be handed out. A label, not access control. Absent means open."
    },
    "images": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/image"
      },
      "description": "Pictures of the package for a catalogue: package files under media/, each with a role. See spec section 4.6."
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/translation"
      },
      "description": "The manifest's title, description, tags and image alt text in other languages, keyed by a tag in locales. See spec section 4.7."
    },
    "tags": {
      "$ref": "#/$defs/tags",
      "description": "Short plain labels in the default language. See spec section 4.8."
    },
    "apps": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[^/?#\\t\\n\\v\\f\\r    -     　﻿][^\\t\\n\\v\\f\\r    -     　﻿]*(?![\\s\\S])"
          },
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
          }
        ]
      },
      "description": "Where the publisher suggests the package is opened, beyond conversation: https: URIs naming apps and app-type tokens, first preferred. Advice only; never fetched. See spec section 4.9."
    },
    "readingOrder": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
      "description": "The IRI of the skos:OrderedCollection in the package's own structure.ttl that orders the whole package. See spec section 4.10."
    },
    "issuedCopies": {
      "type": "object",
      "required": [
        "issuers",
        "paths"
      ],
      "properties": {
        "issuers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "publicKey"
                ],
                "properties": {
                  "publicKey": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An Ed25519 public key, PEM. Compared as key bytes."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "sigstore"
                ],
                "properties": {
                  "sigstore": {
                    "type": "object",
                    "required": [
                      "issuer",
                      "subject"
                    ],
                    "properties": {
                      "issuer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(content|media)/([^/.\\u0000-\\u001f][^/\\u0000-\\u001f]*/)*([^/.\\u0000-\\u001f][^/\\u0000-\\u001f]*)?(?![\\s\\S])"
          }
        }
      },
      "additionalProperties": false,
      "description": "The publisher's consent to issued copies: the issuers it allows and the paths they may mark, under content/ or media/. See spec section 4.11."
    },
    "validFrom": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ],
      "description": "When the package's content comes into force."
    },
    "validUntil": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ],
      "description": "When the package's content stops being in force."
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "description": "Ordered packages this package is composed of, each pinned by digest."
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object"
      },
      "description": "Profile URI -> that profile's package-level data."
    },
    "terms": {
      "type": "object",
      "description": "The creator's terms (package spec section 4.14). Only its type is checked here: terms.schema.json checks the inside, and a problem there is a warning (U001), never M002."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "member": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
          "not": {
            "pattern": "#"
          },
          "description": "A package id; never contains #."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "supersedes | amends | conflictsWith | crossReferences | isPartOf | translationOf | editionOf, or a profile-defined type."
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])",
          "not": {
            "pattern": "#"
          },
          "description": "A package id; never contains #."
        },
        "version": {
          "type": "string",
          "description": "Optional exact version of the target the relation applies to.",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?(?![\\s\\S])"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": [
        "src",
        "role",
        "type"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^media(?:/[^/\\\\]+)+(?![\\s\\S])",
          "not": {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          },
          "description": "A package path to a regular file under media/. Never a URL."
        },
        "role": {
          "enum": [
            "icon",
            "cover"
          ]
        },
        "type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "sizes": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*(?: [1-9][0-9]*x[1-9][0-9]*)*(?![\\s\\S])",
          "description": "Pixel sizes, informative."
        },
        "alt": {
          "$ref": "#/$defs/alt"
        }
      },
      "additionalProperties": false
    },
    "alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
      }
    },
    "translation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "alt": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/alt"
          },
          "description": "An image's src to its alt text in this language."
        }
      },
      "additionalProperties": false
    },
    "creditImage": {
      "type": "object",
      "required": [
        "src",
        "type"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^media(?:/[^/\\\\]+)+(?![\\s\\S])",
          "not": {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          },
          "description": "A package path to a regular file under media/. Never a URL."
        },
        "type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        }
      },
      "additionalProperties": false,
      "description": "A picture of a publisher or contributor: a package file, checked like a manifest image (spec section 4.6, 4.13)."
    },
    "sameAs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s]+(?![\\s\\S])",
        "maxLength": 2048
      },
      "description": "https: URIs of the same party elsewhere, such as ISNI, ORCID or Wikidata (spec section 4.13)."
    },
    "publisher": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+(?![\\s\\S])",
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "image": {
          "$ref": "#/$defs/creditImage"
        },
        "sameAs": {
          "$ref": "#/$defs/sameAs"
        }
      },
      "additionalProperties": false,
      "description": "Who publishes the package (spec section 4.13). The signer's claim, not proof."
    },
    "contributor": {
      "type": "object",
      "required": [
        "name",
        "roles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{3}(?![\\s\\S])"
          },
          "description": "MARC relator codes, such as aut, nrt or hst."
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+(?![\\s\\S])",
          "maxLength": 2048
        },
        "image": {
          "$ref": "#/$defs/creditImage"
        },
        "sameAs": {
          "$ref": "#/$defs/sameAs"
        }
      },
      "additionalProperties": false,
      "description": "A person or organisation credited for the work, with their roles (spec section 4.13). The signer's claim, not proof."
    }
  }
}
