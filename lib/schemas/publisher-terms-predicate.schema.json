{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moca/schemas/v1/publisher-terms-predicate.schema.json",
  "title": "MOCA publisher terms predicate",
  "description": "The predicate of a publisher terms statement, predicateType https://w3id.org/moca/attestations/publisher-terms/v1 (attestations section 4a). The statement's single subject names the rights holder's channel.",
  "type": "object",
  "required": [
    "sequence",
    "issued",
    "expires"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issued": {
      "type": "string",
      "format": "date-time"
    },
    "expires": {
      "type": "string",
      "format": "date-time"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "ai": {
          "$ref": "terms.schema.json#/$defs/ai"
        },
        "repackage": {
          "$ref": "terms.schema.json#/$defs/repackage"
        }
      },
      "additionalProperties": false
    },
    "packagers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "terms.schema.json#/$defs/signer"
      }
    }
  },
  "additionalProperties": false
}
