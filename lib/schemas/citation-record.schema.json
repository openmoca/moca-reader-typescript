{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moca/schemas/v1/citation-record.schema.json",
  "title": "MOCA citation record",
  "description": "What a Reader or adapter hands to an application for one node or chunk. Normative: spec/moca-reader-contract.md section 7.",
  "type": "object",
  "required": [
    "package",
    "node",
    "trust"
  ],
  "properties": {
    "package": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest",
        "signed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "signed": {
          "type": "boolean"
        },
        "signers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "datePublished": {
          "type": "string",
          "description": "The manifest's datePublished, as written (spec/moca-package-spec.md §4.12)."
        },
        "datePackaged": {
          "type": "string",
          "description": "The manifest's datePackaged, as written (spec/moca-package-spec.md §4.12)."
        },
        "issuedCopy": {
          "type": "object",
          "required": [
            "originalDigest",
            "issuers"
          ],
          "properties": {
            "originalDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
            },
            "issuers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Set for an issued copy bound to its publisher's package (attestations §7.1): the original digest, the same for every copy, and the issuers' signers."
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "path",
        "type",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Versioned node reference: <package id>@<version>#<path>. Unique across package versions; use it as the citation key."
        },
        "issuedChange": {
          "type": "boolean",
          "description": "true when the record comes from a file the issuer of an issued copy changed (attestations §7.1). Absent otherwise."
        },
        "datePublished": {
          "type": "string",
          "description": "The node's moca.date_published, as written. Never copied from the package."
        },
        "media": {
          "type": "array",
          "description": "The node's valid media descriptions (spec/moca-package-spec.md §5.7), in order.",
          "items": {
            "type": "object",
            "required": [
              "source",
              "resource",
              "type"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "resource": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
              },
              "transcript": {
                "type": "string"
              },
              "alternateOf": {
                "type": "string"
              },
              "sync": {
                "type": "array",
                "minItems": 1,
                "description": "Stretches of the reference's timeline, in order of `at` (spec/moca-package-spec.md §5.7).",
                "items": {
                  "type": "object",
                  "required": [
                    "at",
                    "offset"
                  ],
                  "properties": {
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "offset": {
                      "description": "Seconds to add to a moment in this stretch to find it on the alternate; null: this stretch is not in the alternate (package spec section 5.7).",
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "contributors": {
          "type": "array",
          "description": "The node's own moca.contributors, as written, when they match the node schema (Reader contract section 7). Images that fail their check are left out.",
          "items": {
            "type": "object"
          }
        },
        "license": {
          "type": "string",
          "description": "The node's licence: its terms.nodes entry's rights.license, else the manifest's license (Reader contract §7)."
        },
        "copyright": {
          "type": "object",
          "description": "The node's copyright statement: its terms.nodes entry's rights.copyright, else terms.rights.copyright, as written (Reader contract §7)."
        }
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "UTF-8 byte offsets into the node file."
    },
    "text": {
      "type": "string"
    },
    "trust": {
      "type": "object",
      "required": [
        "status",
        "declaredVerified",
        "attestedReviews",
        "reviewStatus",
        "stale",
        "inForce",
        "superseded",
        "contested"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "stable",
            "deprecated"
          ]
        },
        "generated": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "by"
              ],
              "properties": {
                "by": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "declaredVerified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "by"
            ],
            "properties": {
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          },
          "description": "OKF verified entries: self-declared, not cryptographically checked."
        },
        "attestedReviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reviewer",
              "reviewedAt",
              "outcome",
              "signer",
              "packageVerified"
            ],
            "properties": {
              "reviewer": {
                "type": "string"
              },
              "reviewedAt": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "accurate",
                  "needs-change",
                  "inaccurate"
                ]
              },
              "scope": {
                "type": "string"
              },
              "signer": {
                "type": "string"
              },
              "fileChanged": {
                "type": "boolean",
                "description": "true for a review of a file the issuer of an issued copy changed. It never counts toward reviewStatus (attestations §7.1)."
              },
              "packageVerified": {
                "type": "boolean",
                "description": "Whether the package carrying the review has a valid package attestation. A review in an unsigned package never counts as approved (ADR-0017)."
              }
            }
          }
        },
        "reviewStatus": {
          "enum": [
            "approved",
            "disputed",
            "unverified",
            "none"
          ],
          "description": "approved: signed, a current review is accurate and none says otherwise; disputed: signed, and a current review says needs-change or inaccurate; unverified: reviews in an unsigned package; none: no current review (Reader contract §7)."
        },
        "staleAfter": {
          "type": "string"
        },
        "validFrom": {
          "type": "string"
        },
        "validUntil": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        },
        "inForce": {
          "type": "boolean"
        },
        "superseded": {
          "type": "boolean"
        },
        "supersededBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contested": {
          "type": "boolean"
        },
        "contestedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "object"
          },
          "selector": {
            "type": "object"
          },
          "note": {
            "type": "string"
          },
          "matched": {
            "type": "boolean",
            "description": "true when the Reader checked the selector against the cited file inside the package and it matched; false when it did not match; absent when not checked. It says the quote is in the file, not that the claim is true."
          },
          "located": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "description": "For a time range refined by a quote that matched: the seconds, on the cited source's timeline, from the start of the first cue the quote touches to the end of the last (spec/moca-reader-contract.md §7)."
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "description": "Absolute concept IRIs the node is bound to, from the package structure (moca.concepts).",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])"
      }
    },
    "audience": {
      "type": "string"
    },
    "audienceInvalid": {
      "const": true,
      "description": "Present when the node's moca.audience is malformed: the record never matches an audience set (Reader contract §8)."
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score": {
      "type": "number"
    },
    "terms": {
      "type": "object",
      "description": "Resolved terms for the record's node, only in records from a search with a terms request (Reader contract section 15.4).",
      "required": [
        "authority"
      ],
      "properties": {
        "authority": {
          "enum": [
            "packager",
            "unverified"
          ]
        },
        "ai": {
          "type": "object",
          "description": "Each permission of terms.ai, in the same shape (allowed.device, allowed.host, allowed.provider, allowed.training, allowed.machineTranslation, allowed.mention, providerRequires, answerSources), as { value, decidedBy }.",
          "properties": {
            "allowed": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "value",
                  "decidedBy"
                ],
                "properties": {
                  "value": true,
                  "decidedBy": {
                    "enum": [
                      "platform",
                      "package",
                      "node",
                      "composite",
                      "host"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "decidedBy"
            ],
            "properties": {
              "value": true,
              "decidedBy": {
                "enum": [
                  "platform",
                  "package",
                  "node",
                  "composite",
                  "host"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "rating": {
          "type": "object"
        },
        "rights": {
          "type": "object",
          "description": "Resolved rights permissions: export, as { value, decidedBy } (Reader contract section 15.3).",
          "properties": {
            "export": {
              "type": "object",
              "required": [
                "value",
                "decidedBy"
              ],
              "properties": {
                "value": true,
                "decidedBy": {
                  "enum": [
                    "platform",
                    "package",
                    "composite"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "description": "How a search found this record (ADR-0010): through the backend, or added by a retrieval hook following the structure.",
      "required": [
        "via"
      ],
      "properties": {
        "via": {
          "enum": [
            "search",
            "requires",
            "parts",
            "narrower",
            "related"
          ]
        },
        "from": {
          "type": "string",
          "description": "The concept IRI the record was reached from."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
