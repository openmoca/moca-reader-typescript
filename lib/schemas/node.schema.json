{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moca/schemas/v1/node.schema.json",
  "title": "MOCA content node frontmatter",
  "description": "OKF v0.2 concept-document frontmatter plus MOCA's `moca` extension mapping. See spec/moca-package-spec.md section 5.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r    -     　﻿]",
      "description": "Required by OKF: not empty and not only white space."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The model's name and version, for content a model made (package spec section 4.14)."
        }
      },
      "additionalProperties": true
    },
    "verified": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "by",
            "at"
          ],
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date-time"
                },
                {
                  "format": "date"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "by",
              "at"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "anyOf": [
                  {
                    "format": "date-time"
                  },
                  {
                    "format": "date"
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "status": {
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "stale_after": {
      "type": "string",
      "anyOf": [
        {
          "format": "date-time"
        },
        {
          "format": "date"
        }
      ]
    },
    "moca": {
      "$ref": "#/$defs/moca"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "media": {
      "type": "object",
      "required": [
        "source",
        "type"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]{0,126}(?:[ \\t]*;[^\\n\\r]*)?(?![\\s\\S])"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "alternateOf": {
          "type": "string",
          "minLength": 1,
          "description": "The `source` of the description this one is an alternate of."
        },
        "sync": {
          "type": "array",
          "minItems": 1,
          "description": "Stretches of the reference's timeline, in order of `at` (spec/moca-package-spec.md §5.7).",
          "items": {
            "type": "object",
            "required": [
              "at",
              "offset"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "offset": {
                "description": "Seconds to add to a moment in this stretch to find it on the alternate; null: this stretch is not in the alternate (package spec section 5.7).",
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "captions": {
          "type": "array",
          "description": "Caption and subtitle tracks, each a WebVTT source with its language and HTML track kind (spec/moca-package-spec.md §5.7).",
          "items": {
            "type": "object",
            "required": [
              "source",
              "language"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
              },
              "kind": {
                "enum": [
                  "subtitles",
                  "captions",
                  "descriptions",
                  "chapters"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "resource"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "usage_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_modified": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ]
        },
        "usage_window": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date-time"
                },
                {
                  "format": "date"
                }
              ]
            },
            "to": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date-time"
                },
                {
                  "format": "date"
                }
              ]
            }
          }
        }
      },
      "additionalProperties": true
    },
    "moca": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "valid_from": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ]
        },
        "valid_until": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ]
        },
        "contested_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "media": {
          "type": "array",
          "description": "Descriptions of the node's audio and video sources (spec/moca-package-spec.md §5.7).",
          "items": {
            "$ref": "#/$defs/media"
          }
        },
        "date_published": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ],
          "description": "When the node's content was first published (spec/moca-package-spec.md §4.12)."
        },
        "concepts": {
          "type": "array",
          "description": "Concepts from the package's structure.ttl this node is bound to (spec/moca-package-spec.md §5.6).",
          "items": {
            "type": "object",
            "required": [
              "iri"
            ],
            "properties": {
              "iri": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\t\\n\\v\\f\\r    -     　﻿]+(?![\\s\\S])"
              },
              "role": {
                "enum": [
                  "primary",
                  "supporting"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "contributors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/contributor"
          },
          "description": "People and organisations credited for this node, with MARC relator roles (spec/moca-package-spec.md section 4.13)."
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "selector"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "FragmentSelector"
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "conformsTo": {
              "type": "string"
            },
            "refinedBy": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                }
              },
              "description": "A selector within this one (W3C Web Annotation). On a media time range, a TextQuoteSelector is checked against the cues the range covers (spec/moca-reader-contract.md §7)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "exact"
          ],
          "properties": {
            "type": {
              "const": "TextQuoteSelector"
            },
            "exact": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "start",
            "end"
          ],
          "properties": {
            "type": {
              "const": "TextPositionSelector"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "creditImage": {
      "type": "object",
      "required": [
        "src",
        "type"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^media(?:/[^/\\\\]+)+(?![\\s\\S])",
          "not": {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          },
          "description": "A package path to a regular file under media/. Never a URL."
        },
        "type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        }
      },
      "additionalProperties": false,
      "description": "A picture of a publisher or contributor: a package file, checked like a manifest image (spec section 4.6, 4.13)."
    },
    "sameAs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s]+(?![\\s\\S])",
        "maxLength": 2048
      },
      "description": "https: URIs of the same party elsewhere, such as ISNI, ORCID or Wikidata (spec section 4.13)."
    },
    "contributor": {
      "type": "object",
      "required": [
        "name",
        "roles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{3}(?![\\s\\S])"
          },
          "description": "MARC relator codes, such as aut, nrt or hst."
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+(?![\\s\\S])",
          "maxLength": 2048
        },
        "image": {
          "$ref": "#/$defs/creditImage"
        },
        "sameAs": {
          "$ref": "#/$defs/sameAs"
        }
      },
      "additionalProperties": false,
      "description": "A person or organisation credited for the work, with their roles (spec section 4.13). The signer's claim, not proof."
    }
  }
}
